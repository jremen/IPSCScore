{
  "name": "@ipscscore/core",
  "version": "2.7.0",
  "private": true,
  "description": "Shared IPSCScore domain types and scoring calculations",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
