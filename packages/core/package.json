      "default": "./src/domain/index.ts"
    },
    "./scoring": {
      "types": "./src/scoring/index.ts",
      "default": "./src/scoring/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
